# Telegram (chat ID is filled in by setup.ps1 via getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Basic auth for dashboard and API
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=

# LLM chain (Phase 4), all free tiers. Leave blank to skip a provider.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Backup to a NAS share (Phase 5). Only needed for a UNC path; local drives use folder ACLs instead.
BACKUP_SMB_USER=
BACKUP_SMB_PASS=
