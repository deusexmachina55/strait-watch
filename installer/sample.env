# Optional. Rename to .env and fill in before running INSTALL.cmd to preload the settings.
# Everything here can also be entered on the Settings page after install. Values in single quotes.

# Dashboard login (password: 16+ characters)
BASIC_AUTH_USER='admin'
BASIC_AUTH_PASS=''

# Telegram bot from @BotFather. Chat ID can be left empty and detected on the Settings page.
TELEGRAM_BOT_TOKEN=''
TELEGRAM_CHAT_ID=''

# LLM providers, all free tiers. One is enough; Groq is the most reliable.
GROQ_API_KEY=''
GEMINI_API_KEY=''
OPENROUTER_API_KEY=''

# Ships on the map (aisstream.io, GitHub login)
AISSTREAM_API_KEY=''

# NAS share credentials, only for a UNC backup path
BACKUP_SMB_USER=''
BACKUP_SMB_PASS=''

# Display timezone (IANA name)
STRAIT_TZ='Asia/Singapore'
